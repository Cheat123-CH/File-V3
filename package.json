    "description": "One Stop Service File",
    "scripts": {
        "start:dev" : "nodemon",
        "start:prod": "node -r tsconfig-paths/register dist/main.js",
        "build:prod": "tsc && cp -r src/view dist/view && cp -r src/public dist/public",
        "migrate"   : "ts-node -r tsconfig-paths/register src/database/file.migrate.ts",
        "seed"      : "ts-node -r tsconfig-paths/register src/database/seed.ts"
    },
    "dependencies": {
        "@types/cors": "^2.8.17",
        "@types/fs-extra": "^11.0.4",
        "@types/multer": "^1.4.11",
        "@types/uuid": "^9.0.8",
        "body-parser": "^1.20.2",
        "colors": "^1.4.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "ejs": "^3.1.9",
        "express": "^4.22.1",
        "express-validator": "^7.0.1",
        "fs-extra": "^11.2.0",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.9.2",
        "pg": "^8.11.3",
        "sequelize": "^6.37.1",
        "sequelize-typescript": "^2.1.6",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.25",
        "nodemon": "^3.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.2"
    }
}
